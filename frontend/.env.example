# Copiar a .env.local y rellenar con valores reales.
# .env.local NO se commitea (lo cubre el .gitignore raíz).

# URL del Cloudflare Worker del chat. Si no está definida, el chat cae al
# mock keyword-matching (útil en dev local sin worker corriendo).
# Producción: el secret VITE_CHAT_API_URL en GitHub Actions inyecta el valor
# real en el build de Pages.
VITE_CHAT_API_URL=https://luisana-portfolio-chat.<subdominio>.workers.dev
