# Copiar este archivo a .env y rellenar con valores reales.
# .env NO se commitea (está en .gitignore).

# Groq API key — para llamar a los modelos via Groq (fast: Llama 3.1 8B Instant, quality: Llama 3.3 70B)
GROQ_API_KEY=gsk_...

# GitHub token con permiso de leer repos privados (opcional, solo si los hay)
GH_TOKEN=ghp_...

# Token para autenticar /admin del Drafts Worker
ADMIN_TOKEN=cambiame_a_algo_aleatorio

# Solo cuando se llegue a la Fase 5
LINKEDIN_ACCESS_TOKEN=
DEVTO_API_KEY=
